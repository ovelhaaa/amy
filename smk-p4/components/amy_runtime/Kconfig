menu "SMK-P4 AMY capacity"
config SMKP4_HARMONY
    bool "0.9 live scale and chord assist (experimental)"
    depends on SMKP4_UNIFIED_ENGINE && SMKP4_AMY_VOICES_8
    default n
config SMKP4_UNIFIED_ENGINE
    bool "0.8 reusable instruments (candidate; no physical qualification)"
    depends on SMKP4_STANDALONE
    default n
choice SMKP4_AMY_POLYPHONY
    prompt "Musical voices (fixed at boot)"
    depends on SMKP4_STANDALONE
    default SMKP4_AMY_VOICES_4
config SMKP4_AMY_VOICES_4
    bool "4 voices (qualified baseline)"
config SMKP4_AMY_VOICES_6
    bool "6 voices (candidate; hardware qualification required)"
config SMKP4_AMY_VOICES_8
    bool "8 voices (experimental; qualify 6 on hardware first)"
endchoice
config SMKP4_AMY_VOICES
    int
    default 8 if SMKP4_AMY_VOICES_8
    default 6 if SMKP4_AMY_VOICES_6
    default 4
endmenu
