menu "SMK-P4 standalone PCM5102A bring-up"
config SMKP4_STANDALONE
    bool "Standalone bring-up application"
    default n
config SMKP4_PCM_WIRING_CONFIRMED
    bool "Operator confirmed JP1, DAC supply/straps and disconnected S3 UART"
    depends on SMKP4_STANDALONE && !SMK_LINK_ENABLED
    default n
    help
        Enables physical I2S output. Leave off until the wiring guide is checked.
config SMKP4_PCM_BCLK
    int "BCLK GPIO (candidate JP1-11)"
    range 50 52
    default 50
config SMKP4_PCM_WS
    int "WS GPIO (candidate JP1-9)"
    range 50 52
    default 51
config SMKP4_PCM_DATA
    int "DOUT GPIO (candidate JP1-7)"
    range 50 52
    default 52
config SMKP4_PCM_TEST_SEQUENCE
    bool "Audible test: silence / left / right / stereo / silence (2s each)"
    default n
config SMKP4_PCM_DIAGNOSTIC
    bool "Use diagnostic tone/silence instead of local AMY"
    depends on SMKP4_STANDALONE
    default n
    help
        When enabled, PCM_TEST_SEQUENCE selects silence or the channel sequence.
        Musical controls remain disabled. AMY is the normal standalone source.
config SMKP4_AMY_RAM_SELF_TEST
    bool "Run explicit AMY ROM/chord/release/Panic diagnostic in RAM at boot"
    depends on SMKP4_STANDALONE && !SMKP4_PCM_WIRING_CONFIRMED && !SMKP4_PCM_DIAGNOSTIC
    default n
    help
        Never initializes I2S. Logs PCM metrics for comparison with the same
        host diagnostic. Boot may take several seconds; not normal performance.
config SMKP4_PCM_TEST_HZ
    int "Test tone frequency Hz"
    range 20 20000
    default 440
endmenu
