menu "SMK-P4 presentation"
config SMKP4_UI_BLUEPRINT
    bool "Use Blueprint 1.1 with live Performance adapter"
    depends on SMKP4_STANDALONE && !SMKP4_PCM_DIAGNOSTIC
    default n
    select LV_FONT_MONTSERRAT_14
    select LV_FONT_MONTSERRAT_20
    select LV_FONT_MONTSERRAT_28
    help
        Reuses the existing UI task and LVGL display/touch. Legacy UI remains
        default until physical memory/audio integration gates pass.
config SMKP4_SOUND_LIBRARY
    bool "Opt-in 0.7 resident FM library candidate (128/135/138/142)"
    depends on SMKP4_STANDALONE
    default n
    help
        Four boot-resident banks; fixed musical polyphony. Requires independent
        memory/audio qualification. No dynamic patch loading or new effects.
endmenu

config SMKP4_FULL_FACTORY_LIBRARY
    bool "Qualified full Juno/DX7 factory catalog"
    depends on SMKP4_UNIFIED_ENGINE && SMKP4_HARMONY
    default n

config SMKP4_SOUND_EDITOR
    bool "Experimental live sound editor 0.11 and User Presets"
    depends on SMKP4_FULL_FACTORY_LIBRARY && SMKP4_UI_BLUEPRINT
    default n
