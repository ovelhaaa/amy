      "required": true,
      "method": "max",
      "op": "le",
      "limit": 5333,
      "unit": "us",
      "rationale": "256 frames a 48 kHz com medicao inteira em microssegundos.",
      "record": "AUDIO",
      "field": "render_max_us",
      "cumulative": true
    },
    {
      "id": "owner_stack",
      "group": "memoria",
      "required": true,
      "method": "min",
      "op": "ge",
