CONFIG_SMKP4_STANDALONE=y
# CONFIG_SMK_LINK_ENABLED is not set
# CONFIG_SMKP4_PCM_WIRING_CONFIRMED is not set
# CONFIG_SMKP4_PCM_TEST_SEQUENCE is not set
CONFIG_SMKP4_PCM_BCLK=50
CONFIG_SMKP4_PCM_WS=51
CONFIG_SMKP4_PCM_DATA=52
CONFIG_SMKP4_PCM_TEST_HZ=440

