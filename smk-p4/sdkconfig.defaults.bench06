# Operator reconfirmed unchanged qualified Guition wiring on 2026-11-04.
# Build-only candidate; explicit authorization is still required before upload.
CONFIG_SMKP4_PCM_WIRING_CONFIRMED=y
CONFIG_SMKP4_PCM_BCLK=50
CONFIG_SMKP4_PCM_WS=51
CONFIG_SMKP4_PCM_DATA=52
CONFIG_SMKP4_USB_WIRING_CONFIRMED=y
CONFIG_SMKP4_USB_CONTROLLER=0
CONFIG_SMKP4_USB_DESCRIPTOR_LOG=y
CONFIG_SMKP4_USB_MIDI_TRACE=y
# CONFIG_SMKP4_PCM_DIAGNOSTIC is not set
# CONFIG_SMKP4_AMY_RAM_SELF_TEST is not set
